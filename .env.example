# OpenRouter
OPENROUTER_API_KEY=replace-me
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=http://localhost:8000
OPENROUTER_APP_TITLE=1010100111101V

# Runtime
APP_ENV=development
LOG_LEVEL=INFO
PORT=8000

# Neo4j / Graphiti
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j
GRAPHITI_ENABLED=true

# Redis short-term memory
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_SECONDS=86400

# PostgreSQL (application data / Railway native link)
DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:5432/agentdb

# Serena MCP/LSP adapter
SERENA_MCP_URL=http://localhost:9121/mcp
SERENA_ENABLED=false

# Safety limits
SHELL_COMMAND_TIMEOUT=20
SHELL_ALLOWED_COMMANDS=python,pytest,git,ls,pwd,cat,grep
